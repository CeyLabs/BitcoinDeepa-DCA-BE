{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": [
    "<rootDir>/support/e2e-env.ts",
    "<rootDir>/support/silence-logger.ts"
  ],
  "testTimeout": 30000,
  "maxWorkers": 1
}
