NODE_ENV=production
# NODE_ENV=development logs every external API call (request + response, secrets redacted)
# and, on Railway, writes JSON lines (INFO/WARN/ERROR badges, filters like @api:CeyPay @status:500).
# LOG_FORMAT=json|pretty overrides the format (development only).
# LOG_FORMAT=

# Public URL of this API, e.g. https://api.example.com (required in production)
BASE_URL=

TELEGRAM_BOT_TOKEN=

# User app (Mini App + web) public origin, e.g. https://app.bitcoindeepa.com. Required in production.
# Gets credentialed CORS; cookie-authenticated writes must carry an Origin from here; the web login
# returns here. The session cookie is this API's; in production the app and API share a site.
APP_URL=
# Dev/staging only, when the app and API are on different sites (vercel.app + railway.app):
# none = SameSite=None; Secure session cookie (HTTPS; refused in production; Safari/iOS still block it).
# APP_COOKIE_SAME_SITE=none

# Log In with Telegram (OIDC redirect + PKCE), from @BotFather -> bot -> Login Widget.
# Client ID = the bot ID. Register BASE_URL/auth/telegram/callback under Allowed URLs.
# Required in production.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# TELEGRAM_OIDC_REDIRECT_URI=          # default: BASE_URL/auth/telegram/callback
# TELEGRAM_OIDC_SCOPE=openid profile   # must include profile (the numeric id we link on)

# Proxies in front of this API (Railway's edge), so req.ip is the real
# client for the login rate limit: a hop count (e.g. 1) or proxy IPs/CIDRs. Required in production
# (unset, every client looks like the proxy and shares one limit).
# TRUST_PROXY=

# Legacy 7-day JWT logins (POST /auth/telegram, /auth/telegram-oidc). Set to false right after
# the session-based app deploys: they answer 410; already-issued JWTs keep working until expiry.
# LEGACY_JWT_ISSUE=true

LOG_GROUP_ID=
LOG_TOPIC_ID=

# Database Configuration
# Docker local dev: postgresql://bitcoindeepa_dca:bitcoindeepa_dca@localhost:5432/bitcoindeepa_dca
DATABASE_URL=postgresql://bitcoindeepa_dca:bitcoindeepa_dca@localhost:5432/bitcoindeepa_dca
# OR individual values:
PG_HOST=localhost
PG_PORT=5432
PG_DB=bitcoindeepa_dca
PG_USER=bitcoindeepa_dca
PG_PW=bitcoindeepa_dca
# Apply pending migrations when the app starts. Unset: only when NODE_ENV=production.
# 'true' turns it on elsewhere, 'false' turns it off in production (then run `bun run migrate`).
# RUN_MIGRATIONS_ON_STARTUP=

# Required - the app refuses to start without it
JWT_SECRET=

# Required for internal endpoints (e.g. POST /transaction/reset-retry-count/:paymentId via x-admin-key header)
ADMIN_API_KEY=

# Admin dashboard auth (Better Auth) - required in production
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: Better Auth URL if it differs from BASE_URL
# BETTER_AUTH_URL=
# Admin dashboard origin(s), comma-separated, e.g. https://admin.example.com
ADMIN_APP_URL=http://localhost:5173
# Dev/staging only: 'none' if the dashboard is on another site than the API
# (e.g. vercel.app vs railway.app). Not allowed in production.
# ADMIN_COOKIE_SAME_SITE=none

# Authentication
ENABLE_AUTH=true
MOCK_TG_ID=

# PayHere Configuration
# OAuth app (required in production): settlement confirms each payment with
# PayHere before paying out, and plan cancellation uses it too
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_RETURN_URL=
PAYHERE_CANCEL_URL=
PAYHERE_NOTIFY_URL=
PAYHERE_ENV=sandbox # live or sandbox

# Redis Configuration
# Docker local dev: redis://default:redis_password@localhost:6379/0
# Use the public Railway URL when running locally; redis.railway.internal only resolves inside Railway.
REDIS_URL=redis://default:redis_password@localhost:6379/0
REDIS_TTL_DEFAULT=300

# Bitcoin DCA Configuration
# BTC/LKR = Ceylon Cash BTC/USD × CeyPay USDT/LKR (needs the CEYPAY_API_* vars below)
ENABLE_BITCOIN_TRACKING=true
# CoinMarketCap: only the wallet's 24h change (display), never a price. Without it the change shows 0
COINMARKETCAP_API_KEY=
BTC_PRICE_CACHE_TTL=300  # seconds - 24h change cache
# When the live BTC/LKR price is down, buys/DCA payments are priced from the active
# exchange_rate_log row if it is at most this old (seconds; default 180, max 900,
# 0 = never; left empty = the default)
EXCHANGE_RATE_FALLBACK_MAX_AGE_SECONDS=180

# Fee Configuration (in basis points - 1 basis point = 0.01%)
# Example: 100 = 1%, 250 = 2.5%, 500 = 5%
PAYHERE_FEE_BASIS_POINTS=100    # PayHere transaction fee
BITCOINDEEPA_FEE_BASIS_POINTS=100  # BitcoinDeepa platform fee

# BitcoinDeepa bot wallet API (Ed25519-signed; HMAC is gone)
BITCOINDEEPA_API_URL=                  # dev bot URL / https://bitcoindeepa.com
BITCOINDEEPA_WALLET_ID=                # X-Wallet-ID, dev: BiccoindeepaDSATest
# Two Ed25519 key pairs, different per environment (four in total). Multi-line PEM, or one line
# with literal \n. Give the bot operator the public keys, saying which is which:
#   openssl genpkey -algorithm ed25519 -out dca-send.pem
#   openssl pkey -in dca-send.pem -pubout -outform DER | tail -c 32 | base64   # public key
# Send key: our DCA wallet (payouts, collect requests) -> the wallet's ed25519_public_key
BITCOINDEEPA_PRIVATE_KEY_PEM=
# P2P key: users' own wallets (login via /api/v1/init, then X-BDB-User) -> api.p2p.service_public_key.
# If it leaks it can pay from any linked user's wallet up to the bot's daily_limit: secret store only.
BITCOINDEEPA_P2P_PRIVATE_KEY_PEM=
BITCOINDEEPA_TIMEOUT=10000             # ms, every call except /send
BITCOINDEEPA_SEND_TIMEOUT=95000        # ms, /send (an invoice payment can wait 60s)
# API URL, wallet id and key are required in production (no HMAC fallback)
# Optional: shared secret the bot sends as X-Callback-Secret on POST /transaction/reset-retry-counts.
# When set, the callback requires it (ask the bot operator to send it). Min 16 chars.
# BITCOINDEEPA_CALLBACK_SECRET=

# P2P sends: users send sats from their own bot wallet (relayed to the bot's /api/v1/p2p).
# On by default; P2P_ENABLED=false is the off-switch (/p2p/* answers 503). Signed with
# BITCOINDEEPA_P2P_PRIVATE_KEY_PEM (above); without it P2P is off. Each login links the user on the
# bot (its /api/v1/init); later calls name them with X-BDB-User (no Telegram re-login).
# P2P_ENABLED=false

# Sell flow (sats -> LKR via CeyPay aggregator off-ramp)
SELL_ENABLED=false     # true turns it on; the CeyPay webhook key + R2 below are then required in production
# BITCOINDEEPA_COLLECT_MOCK=true  # dev only, sandbox CeyPay only: treat every sell debit as approved and paid (bot wallet without can_collect)
BITCOINDEEPA_SELL_FEE_BASIS_POINTS=100  # taken off the LKR amount
SELL_QUOTE_TTL_SECONDS=60
# SELL_COLLECT_WINDOW_SECONDS=300  # time the user has to approve the payment after confirming (60-900)
SELL_MIN_SATS=1000
# SELL_MAX_SATS=5000000          # largest single sale (default 5,000,000)
# SELL_DAILY_MAX_SATS=20000000   # per member, rolling 24h (default 20,000,000)
# CEYPAY_API_* are required in production even with selling off: CeyPay's USDT/LKR prices every buy
CEYPAY_API_URL=
CEYPAY_API_KEY_ID=          # ak_live_... (key id only)
CEYPAY_API_SECRET=          # sk_live_...
CEYPAY_WEBHOOK_PUBLIC_KEY=  # ED25519 public key (PEM) from CeyPay
# CEYPAY_WEBHOOK_URL=       # optional, defaults to BASE_URL/sell/ceypay-webhook
CEYPAY_TIMEOUT=10000

# Cloudflare R2 (bank statements; private bucket, CORS must allow PUT from the TMA origin)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=            # optional: S3-compatible server instead of R2 (e.g. http://localhost:9000 MinIO)

# Optional: admin dashboard URL for Telegram alert links (defaults to the first ADMIN_APP_URL)
# ADMIN_DASHBOARD_URL=

# Deployment
PORT=3000
CORS_ORIGIN=*

DIDIT_API_KEY=
# Required in production - unsigned/unverifiable KYC webhooks are rejected
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_REDIRECT_URL=
DIDIT_BASE_URL=https://verification.didit.me

# Migrations
ANALYTICS_READONLY_PASSWORD=
