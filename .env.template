NODE_ENV=production

# Public URL of this API, e.g. https://api.example.com (required in production)
BASE_URL=

TELEGRAM_BOT_TOKEN=

# Telegram Login (OIDC) Client ID from @BotFather -> bot -> Login Widget (public, not secret)
TELEGRAM_OIDC_CLIENT_ID=

LOG_GROUP_ID=
LOG_TOPIC_ID=

# Database Configuration
# Docker local dev: postgresql://bitcoindeepa_dca:bitcoindeepa_dca@localhost:5432/bitcoindeepa_dca
DATABASE_URL=postgresql://bitcoindeepa_dca:bitcoindeepa_dca@localhost:5432/bitcoindeepa_dca
# OR individual values:
PG_HOST=localhost
PG_PORT=5432
PG_DB=bitcoindeepa_dca
PG_USER=bitcoindeepa_dca
PG_PW=bitcoindeepa_dca

# Required - the app refuses to start without it
JWT_SECRET=

# Required for internal endpoints (e.g. POST /transaction/reset-retry-count/:paymentId via x-admin-key header)
ADMIN_API_KEY=

# Admin dashboard auth (Better Auth) - required in production
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: Better Auth URL if it differs from BASE_URL
# BETTER_AUTH_URL=
# Admin dashboard origin(s), comma-separated, e.g. https://admin.example.com
ADMIN_APP_URL=http://localhost:5173

# Authentication
ENABLE_AUTH=true
MOCK_TG_ID=

# PayHere Configuration
# OAuth app (required in production): settlement confirms each payment with
# PayHere before paying out, and plan cancellation uses it too
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_RETURN_URL=
PAYHERE_CANCEL_URL=
PAYHERE_NOTIFY_URL=
PAYHERE_ENV=sandbox # live or sandbox

# Redis Configuration
# Docker local dev: redis://default:redis_password@localhost:6379/0
# Use the public Railway URL when running locally; redis.railway.internal only resolves inside Railway.
REDIS_URL=redis://default:redis_password@localhost:6379/0
REDIS_TTL_DEFAULT=300

# Bitcoin DCA Configuration
COINMARKETCAP_API_KEY=
ENABLE_BITCOIN_TRACKING=true
BTC_PRICE_CACHE_TTL=300  # seconds - BTC/USD price from CoinMarketCap
USD_LKR_CACHE_TTL=20     # seconds - USD/LKR rate from Ceylon Cash

# Fee Configuration (in basis points - 1 basis point = 0.01%)
# Example: 100 = 1%, 250 = 2.5%, 500 = 5%
PAYHERE_FEE_BASIS_POINTS=100    # PayHere transaction fee
BITCOINDEEPA_FEE_BASIS_POINTS=100  # BitcoinDeepa platform fee

# BitcoinDeepa Fund Transfer API Configuration
BITCOINDEEPA_API_URL=
BITCOINDEEPA_HMAC_SECRET=
BITCOINDEEPA_TIMEOUT=10000

# Deployment
PORT=3000
CORS_ORIGIN=*

DIDIT_API_KEY=
# Required in production - unsigned/unverifiable KYC webhooks are rejected
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_REDIRECT_URL=
DIDIT_BASE_URL=https://verification.didit.me

# Migrations
ANALYTICS_READONLY_PASSWORD=
